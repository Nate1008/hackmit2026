# Required in Vercel. Public HTTPS origin of the GPU backend.
# The browser connects directly so WebSocket progress and phone uploads work.
NEXT_PUBLIC_SHAPER_API_URL=https://api.example.com

# Required in Vercel. Restrict this browser key to Maps JavaScript API and your
# production/preview domains, for example https://*.vercel.app/*.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace_with_browser_key

# Optional. Defaults to the deployed site's current origin for phone QR links.
NEXT_PUBLIC_HONKPACK_PUBLIC_URL=https://your-project.vercel.app

# Optional same-origin HTTP fallback used by the Next.js proxy route.
# WebSockets still require NEXT_PUBLIC_SHAPER_API_URL above.
SHAPER_INTERNAL_API_URL=https://api.example.com